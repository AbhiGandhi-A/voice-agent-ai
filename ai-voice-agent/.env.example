# =============================================================================
# AI Voice Agent — Environment Configuration
# =============================================================================
# Copy this file to `.env` before starting the backend.
#   - Server vars below are read by Node (server/config/env.ts).
#   - VITE_* vars are inlined into the frontend at build time by Vite.
#   - Replace every `YOUR_*` / `your-*` placeholder with real values.
#   - NEVER commit `.env`. On Vercel, set these in Project > Settings > Env Vars.

# =============================================================================
# LOCAL (Windows backend)
# =============================================================================
PORT=3000
NODE_ENV=development
# Base URL of the backend server itself (used in log messages).
APP_URL=http://localhost:3000
# Comma-separated allowed browser origins (no `*` in production).
# Includes local dev, the Vite dev server, and (optionally) wildcard hosts.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# =============================================================================
# SUPABASE (database + auth) — https://supabase.com → Project Settings > API
# =============================================================================
# Server-side (Node). Service role key NEVER leaves the server.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct Postgres access for `npm run db:setup` (applies the schema migration).
# PostgREST cannot run DDL, so migrations use a real DB connection. Provide ONE:
#   Option A (preferred) — full URI from Dashboard > Connect > Connection string:
#     DATABASE_URL=postgresql://postgres.YOUR-PROJECT:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   Option B — set the project database password; the script auto-derives host
#     db.<ref>.supabase.co, user postgres, db postgres from SUPABASE_URL:
#     SUPABASE_DB_PASSWORD=your-project-db-password
# Optional overrides (Option B only):
#   SUPABASE_DB_HOST=db.YOUR-PROJECT.supabase.co
#   SUPABASE_DB_PORT=5432
#   SUPABASE_DB_USER=postgres
#   SUPABASE_DB_NAME=postgres
# These are secrets — never set as VITE_* vars.

# =============================================================================
# OLLAMA (local AI) — backend talks to Ollama over the local network only.
# Port 11434 is NEVER exposed publicly; only the Express backend reaches it.
# =============================================================================
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Model installed locally. Run `ollama list` to confirm. llama3.2:3b by default.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=30000

# GROQ (backend-only normal-task provider; never use VITE_GROQ_API_KEY)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=30000

# =============================================================================
# FRONTEND (Vite) — LOCAL development values.
# VITE_* variables are public and baked into the JS bundle at build time.
# NEVER put service-role keys, JWT_SECRET, telephony tokens, or API keys here.
# =============================================================================
# Public Supabase anon config (mirrors server vars above; safe for browsers).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Backend API base URL the browser calls.
#   - Local dev: http://localhost:3000 (or leave empty for same-origin).
#   - Vercel: set below under PRODUCTION and build there.
VITE_API_BASE_URL=http://localhost:3000
# Optional: fixed URL the Supabase email-confirmation link redirects to.
# Defaults to window.location.origin. Add it to Supabase Dashboard >
# Auth > URL Configuration > Redirect URLs too.
VITE_AUTH_REDIRECT_URL=

# =============================================================================
# PRODUCTION (Vercel frontend → public backend tunnel/host)
# =============================================================================
# On Vercel set these (NOT locally):
# VITE_API_BASE_URL=https://rebate-slim-charter-express.trycloudflare.com
# CORS_ORIGIN=https://YOUR-VERCEL-DOMAIN.vercel.app
# VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# VITE_AUTH_REDIRECT_URL=https://YOUR-VERCEL-DOMAIN.vercel.app
# Every PRODUCTION var above is public; VITE_* may legally go to the browser.

# =============================================================================
# SIGNALING / MEDIA
# =============================================================================
# web voice = browser STT/TTS + backend /api/ai/chat + Ollama (no keys needed).
STT_PROVIDER=browser
STT_LANGUAGE=en-US
TTS_PROVIDER=browser

# Optional self-hosted STT/TTS engines (phone calls). Leave as placeholders.
WHISPER_SERVER_URL=
STT_API_KEY=
STT_MODEL=small
PIPER_SERVER_URL=http://127.0.0.1:5000
TTS_API_KEY=
TTS_VOICE=en_US-amy

# =============================================================================
# TELEPHONY (real outbound/inbound calling) — server-side only.
# none = not configured (dialer shows NOT CONFIGURED truthfully).
# =============================================================================
TELEPHONY_PROVIDER=none
TELEPHONY_ACCOUNT_ID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_PHONE_NUMBER=
# Secret verifying inbound webhook signatures.
TELEPHONY_WEBHOOK_SECRET=

# =============================================================================
# MISC (server-side)
# =============================================================================
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
REQUEST_BODY_LIMIT_MB=1