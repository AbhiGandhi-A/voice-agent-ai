# -----------------------------------------------------------------------------
# AI Voice Agent — Call Center Platform Environment Configuration
# -----------------------------------------------------------------------------

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
# Comma-separated list of allowed browser origins (no wildcard in production)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Supabase (Primary database, auth, realtime, storage)
# -----------------------------------------------------------------------------
# Create a project at https://supabase.com, then copy from
# Project Settings > API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public/anonymous key — safe to ship to the browser (used for Auth + Realtime).
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key — SERVER-SIDE ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Frontend (Vite) — variables prefixed with VITE_ are inlined into the client
# at build time. After changing these you MUST re-run `npm run build` (or use
# `npm run dev`, which reads them live).
# -----------------------------------------------------------------------------
# Public (anon) client config — mirrors the server vars above.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional: fixed URL for the email-confirmation redirect (defaults to
# window.location.origin). Must also be listed under Supabase Dashboard >
# Auth > URL Configuration > Redirect URLs. For local dev that is
# http://localhost:3000.
VITE_AUTH_REDIRECT_URL=

# -----------------------------------------------------------------------------
# Local AI (Ollama)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
# The model Ollama should use. Run `ollama list` to see installed models.
# Leave empty to force the UI to show "OLLAMA MODEL NOT CONFIGURED".
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Speech-to-Text (STT)
#   browser = browser Web Speech API (web voice mode only)
#   whisper = local faster-whisper HTTP server (phone calls)
#   deepgram / google = external APIs (optional)
# -----------------------------------------------------------------------------
STT_PROVIDER=browser
STT_LANGUAGE=en-US
WHISPER_SERVER_URL=http://127.0.0.1:8000
STT_API_KEY=
STT_MODEL=small

# -----------------------------------------------------------------------------
# Text-to-Speech (TTS)
#   browser = browser speechSynthesis (web voice mode fallback)
#   piper   = local Piper HTTP server (phone calls)
#   kokoro  = local Kokoro HTTP server (phone calls)
# -----------------------------------------------------------------------------
TTS_PROVIDER=browser
PIPER_SERVER_URL=http://127.0.0.1:5000
TTS_API_KEY=
TTS_VOICE=en_US-amy

# -----------------------------------------------------------------------------
# Telephony (real outbound/inbound calling)
#   none   = telephony not configured (dialer shows NOT CONFIGURED)
#   telnyx = Telnyx Call Control + Media Streaming
#   twilio = Twilio Programmable Voice (email/password auth not supported)
# -----------------------------------------------------------------------------
TELEPHONY_PROVIDER=none
TELEPHONY_ACCOUNT_ID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_PHONE_NUMBER=
# Secret used to verify inbound webhook signatures.
TELEPHONY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Analytics / Misc
# -----------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
REQUEST_BODY_LIMIT_MB=1